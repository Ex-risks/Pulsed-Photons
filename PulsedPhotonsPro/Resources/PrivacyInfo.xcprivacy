<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required for App Store submission. This one is almost entirely empty, and
	  honestly so: the application has no network code, no analytics, no
	  identifiers, and reads nothing but the files the user hands it.

	  NSPrivacyAccessedAPITypes is empty because none of the required-reason
	  APIs are used - no file timestamps, no disk space, no system boot time,
	  no active keyboard, and no UserDefaults. Verified by search, not assumed;
	  if any of those are introduced later, the corresponding category and
	  reason code must be added here or the upload will be rejected.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
